# Copy to .env (local) or set in Vercel project settings.

# Postgres (Neon / Supabase / Vercel Postgres / `npx prisma dev` locally)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""

# File storage: "local" (writes to .uploads/, dev only) or "s3" (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email: "console" (logs) or "smtp"
NOTIFY_EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Technentium <no-reply@example.com>"

# SMS / OTP: "console" prints codes to the server log; "fast2sms" texts them (fast2sms.com, free ₹50 starter credit).
SMS_DRIVER="console"
FAST2SMS_API_KEY=""
# "otp" = Fast2SMS ready OTP route (no DLT needed); "dlt" = your DLT sender ID + approved template ID (cheapest at scale)
FAST2SMS_ROUTE="otp"
FAST2SMS_SENDER_ID=""
FAST2SMS_TEMPLATE_ID=""

# "Continue with Google" (free). Create an OAuth client at console.cloud.google.com → APIs & Services → Credentials;
# authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google. Leave empty to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only needed for `prisma migrate dev` against servers that cannot create databases (e.g. `npx prisma dev`)
SHADOW_DATABASE_URL=""

# Connection pool size. Use 1 with `npx prisma dev` (PGlite); leave empty for real Postgres.
DATABASE_POOL_MAX=""

# Analytics (optional). GA4 loads only after the visitor allows analytics in the consent banner.
NEXT_PUBLIC_GA_ID=""
MOBILE_MIN_APP_VERSION="1.0.0"

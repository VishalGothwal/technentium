# Copy to .env (local) or set in Vercel project settings.

# Postgres. Supabase: Dashboard → Connect → ORMs → Prisma.
#  DATABASE_URL  = transaction pooler (port 6543, add ?pgbouncer=true) — used by the app
#  DIRECT_DATABASE_URL = session pooler / direct (port 5432) — used by `prisma migrate` (copy it into DATABASE_URL when migrating)
# Locally you can keep `npx prisma dev` instead.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (Dashboard → Project Settings → API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only — never NEXT_PUBLIC. Needed for staff invites, Users & access controls, "switch user" and seeding demo logins.
SUPABASE_SECRET_KEY=""
# Authentication → Hooks → Send SMS (HTTPS: <APP_URL>/api/auth/hooks/send-sms). Lets Fast2SMS deliver sign-in codes.
SUPABASE_SMS_HOOK_SECRET=""

# Public site address; Supabase redirects back to <APP_URL>/api/auth/callback (add it under Authentication → URL Configuration).
APP_URL="http://localhost:3000"

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""

# File storage: "local" (writes to .uploads/, dev only), "s3" (S3 / Cloudflare R2 / MinIO) or "supabase"
# (private "media" bucket via SUPABASE_SECRET_KEY). Production without S3 settings uses Supabase automatically.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email: "console" (logs) or "smtp"
NOTIFY_EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Technentium <no-reply@example.com>"

# SMS / OTP: "console" prints codes to the server log; "fast2sms" texts them (fast2sms.com, free ₹50 starter credit).
SMS_DRIVER="console"
FAST2SMS_API_KEY=""
# "otp" = Fast2SMS OTP route (no DLT); "q" = Quick SMS with our wording (no DLT, ~₹7/SMS); "dlt" = DLT sender + template (cheapest)
FAST2SMS_ROUTE="otp"
FAST2SMS_SENDER_ID=""
FAST2SMS_TEMPLATE_ID=""

# "Continue with Google" is configured in Supabase (Authentication → Providers → Google), not here.
# Show or hide it in Admin → Feature controls.

# Only needed for `prisma migrate dev` against servers that cannot create databases (e.g. `npx prisma dev`)
SHADOW_DATABASE_URL=""

# Connection pool size. Use 1 with `npx prisma dev` (PGlite); leave empty for real Postgres.
DATABASE_POOL_MAX=""

# Analytics (optional). GA4 loads only after the visitor allows analytics in the consent banner.
NEXT_PUBLIC_GA_ID=""
MOBILE_MIN_APP_VERSION="1.0.0"
